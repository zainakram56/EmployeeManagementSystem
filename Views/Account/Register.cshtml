@{
    ViewData["Title"] = "Set Your Password";
    string token = ViewBag.Token;
}

<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--text-brand);">Set Your Password</h2>
    <p class="text-muted">Welcome! Please set a password to activate your account.</p>
</div>

<div class="card shadow-sm" style="max-width: 500px;">
    <div class="card-body p-4">

        <form method="post" asp-action="Register">
            <input type="hidden" name="token" value="@token" />

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>

            @if (ViewBag.Error != null)
            {
                <p class="text-danger">@ViewBag.Error</p>
            }

            <button type="submit" class="btn btn-primary w-100">Set Password & Activate Account</button>
        </form>

    </div>
</div>

<style>
    .form-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-main);
    }

    .form-control {
        border-color: var(--border);
        border-radius: 8px;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }
</style>
@model List<WebAppMVC.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--text-brand);">Employee Directory</h2>
    <p class="text-muted">
        Manage employee records securely and efficiently.
    </p>
</div>
@if (User.IsInRole("HR"))
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            + New Employee
        </a>
    </div>
}
<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0" id="employeeTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>Role</th>
                <th>Salary</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td class="fw-medium">@employee.Name</td>
                    <td>@employee.Age</td>
                    <td>@employee.Department?.Name</td>
                    <td>
                        @if (employee.IsManager)
                        {
                            <span class="badge badge-manager">Manager</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@employee.Salary</td>
                    <td>
                        @if (User.IsInRole("HR"))
                        {
                            <a asp-action="Edit"
                                   asp-route-id="@employee.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                                   asp-route-id="@employee.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this employee?');">
                                Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    #employeeTable thead {
        background-color: var(--accent-soft);
    }

        #employeeTable thead th {
            color: var(--text-brand);
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 2px solid var(--accent);
            padding: 12px 16px;
        }

    #employeeTable tbody td {
        padding: 12px 16px;
        border-color: var(--border);
    }

    #employeeTable tbody tr:hover {
        background-color: var(--accent-soft);
    }

    .btn-outline-secondary {
        border-radius: 8px;
        font-weight: 500;
        font-size: 13px;
    }
</style>
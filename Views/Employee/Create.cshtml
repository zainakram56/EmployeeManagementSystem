@model WebAppMVC.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
    var departments = ViewBag.Departments as List<WebAppMVC.Models.Department>;
    var managers = ViewBag.Managers as List<WebAppMVC.Models.Employee>;
}

<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--text-brand);">Create Employee</h2>
    <p class="text-muted">Add a new employee record to the directory.</p>
</div>

<div class="card shadow-sm" style="max-width: 500px;">
    <div class="card-body p-4">

        @if (ViewBag.Error != null)
        {
            <p class="text-danger">@ViewBag.Error</p>
        }

        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label">Age <span class="text-danger">*</span></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Department <span class="text-danger">*</span></label>
                <select name="DepartmentId" id="departmentSelect" class="form-select" onchange="filterManagers()">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in departments!)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Salary" class="form-label">Salary <span class="text-danger">*</span></label>
                <input asp-for="Salary" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger d-block mt-1"></span>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="IsManager" value="true" class="form-check-input" id="isManagerCheck" />
                <input type="hidden" name="IsManager" value="false" />
                <label class="form-check-label" for="isManagerCheck">Is this person a Manager?</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Manager</label>
                <select name="ManagerId" id="managerSelect" class="form-select">
                    <option value="">-- No Manager --</option>
                    @foreach (var mgr in managers!)
                    {
                        <option value="@mgr.Id" data-dept="@mgr.DepartmentId">@mgr.Name</option>
                    }
                </select>
                <span asp-validation-for="ManagerId" class="text-danger d-block mt-1"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Save Employee</button>

        </form>

    </div>
</div>

<style>
    .form-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-main);
    }

    .form-control,
    .form-select {
        border-color: var(--border);
        border-radius: 8px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

    .form-check-input:checked {
        background-color: var(--accent);
        border-color: var(--accent);
    }

    .form-check-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
    }
</style>

<script>
    function filterManagers() {
        var deptSelect = document.getElementById("departmentSelect");
        var selectedDeptId = deptSelect.value;
        var managerSelect = document.getElementById("managerSelect");
        var options = managerSelect.getElementsByTagName("option");

        for (var i = 0; i < options.length; i++) {
            var option = options[i];
            var optDept = option.getAttribute("data-dept");

            if (optDept === null) {
                option.style.display = "block";
            } else if (optDept === selectedDeptId) {
                option.style.display = "block";
            } else {
                option.style.display = "none";
            }
        }

        managerSelect.value = "";
    }
</script>

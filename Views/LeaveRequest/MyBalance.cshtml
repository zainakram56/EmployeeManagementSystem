@model List<WebAppMVC.Models.LeaveBalance>

@{
    ViewData["Title"] = "My Leave Balance";
}

<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--text-brand);">My Leave Balance</h2>
    <p class="text-muted">Your remaining leave days for @DateTime.Now.Year.</p>
</div>

<table class="table table-hover table-bordered align-middle shadow-sm" id="balanceTable">
    <thead>
        <tr>
            <th>Leave Type</th>
            <th>Allocated Days</th>
            <th>Used Days</th>
            <th>Remaining</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var balance in Model)
        {
            int remaining = balance.AllocatedDays - balance.UsedDays;

            <tr>
                <td>@balance.LeaveType?.Name</td>
                <td>@balance.AllocatedDays</td>
                <td>@balance.UsedDays</td>
                <td>
                    <span class="badge @(remaining <= 2 ? "bg-danger" : "bg-success")">
                        @remaining days left
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    #balanceTable thead {
        background-color: var(--accent-soft);
    }

        #balanceTable thead th {
            color: var(--text-brand);
            font-weight: 600;
            border-bottom: 2px solid var(--accent);
        }

    #balanceTable tbody td {
        border-color: var(--border);
    }
</style>

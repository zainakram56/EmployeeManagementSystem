@model List<WebAppMVC.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--text-brand);">My Leave Requests</h2>
    <p class="text-muted">Track the status of your leave applications.</p>
</div>

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Apply" class="btn btn-primary">+ Apply for Leave</a>
</div>

<table class="table table-hover table-bordered align-middle shadow-sm" id="requestsTable">
    <thead>
        <tr>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Applied On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.LeaveType?.Name</td>
                <td>@request.StartDate.ToShortDateString()</td>
                <td>@request.EndDate.ToShortDateString()</td>
                <td>@request.Reason</td>
                <td>
                    <span class="badge
                        @(request.Status == WebAppMVC.Models.LeaveStatus.Approved ? "bg-success" :
                                                                              request.Status.ToString().Contains("Rejected") ? "bg-danger" : "bg-warning text-dark")">
                        @request.Status
                    </span>
                </td>
                <td>@request.AppliedOn.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<style>
    #requestsTable thead {
        background-color: var(--accent-soft);
    }

        #requestsTable thead th {
            color: var(--text-brand);
            font-weight: 600;
            border-bottom: 2px solid var(--accent);
        }

    #requestsTable tbody td {
        border-color: var(--border);
    }
</style>
